# Copy to .env.local. Only STRAPI_ENQUIRY_TOKEN is needed for local development.
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi admin > Settings > API Tokens > custom token with only Enquiry: create.
STRAPI_ENQUIRY_TOKEN=

# Optional: only if the Strapi Public role can't read the catalogue.
STRAPI_API_TOKEN=

# Optional: Strapi webhook -> POST /api/revalidate with header x-revalidate-secret.
REVALIDATE_SECRET=

# Optional: email a notification for each quote request.
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=
MAIL_FROM=
