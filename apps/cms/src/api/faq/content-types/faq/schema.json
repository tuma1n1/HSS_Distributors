{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "blocks",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": [
        "ordering",
        "delivery",
        "payments",
        "products",
        "credit_terms",
        "general"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
